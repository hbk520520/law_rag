# Copy the values into the environment used to launch Python; this file is not auto-loaded.
DEEPSEEK_API_KEY=
LEGAL_API_BASE=https://api.deepseek.com
LEGAL_API_MODEL=deepseek-flash
LEGAL_DEVICE=cuda
LEGAL_EMBEDDING_MODEL=BAAI/bge-base-zh-v1.5
LEGAL_EMBEDDING_REVISION=f03589ceff5aac7111bd60cfc7d497ca17ecac65
LEGAL_RERANKER_MODEL=BAAI/bge-reranker-base
LEGAL_RERANKER_REVISION=2cfc18c9415c912f9d8155881c133215df768a70
# LEGAL_PREPARED_DIR=D:/program/graph/prepared/agent-index-v1
# LEGAL_LLM_MODEL=D:/program/generate/model
LEGAL_RETRIEVAL_BACKEND=local
LEGAL_TRITON_URL=localhost:8000
LEGAL_RECALL_K=20
LEGAL_VERIFY_K=8
LEGAL_CONTEXT_K=3
LEGAL_GRAPH_BUDGET=8
# Optional externally supplied parameters. No parameters are fitted by this project.
# LEGAL_CALIBRATION_FILE=D:/program/support_calibration.json
LEGAL_DISTANCE_SCALE=2
LEGAL_MAX_DEPENDENCY_HOPS=8
LEGAL_RECURRENCE_GAIN=0.15
# Optional source metadata: validity dates, original-source grouping and provenance.
# LEGAL_SOURCE_METADATA=D:/program/source_metadata.json
LEGAL_AGENT_MAX_TOOLS=6
LEGAL_AGENT_MAX_STEPS=10
# LEGAL_SESSION_DB=D:/program/output/agent/cases.sqlite3
# LEGAL_MODEL_CACHE=D:/program/output/agent/model-cache
